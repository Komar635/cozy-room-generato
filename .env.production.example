# Production template for Vercel/Supabase. Copy values into Vercel Project Settings,
# not into a committed .env file. Keep real secrets out of git.

# Database
DATABASE_URL=postgresql://user:password@host:5432/reality_digitizer_3d

# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NextAuth
NEXTAUTH_URL=https://your-production-domain.example
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Auth mode
AUTH_PROVIDER=local

# S3-compatible storage or production object storage
MINIO_ENDPOINT=your-storage-endpoint
MINIO_ACCESS_KEY=your-storage-access-key
MINIO_SECRET_KEY=your-storage-secret-key
MINIO_BUCKET_NAME=reality-digitizer-3d

# AI and processing services
GEMINI_API_KEY=your-gemini-api-key
PHOTOGRAMMETRY_SERVICE_URL=https://your-photogrammetry-service.example
MODIFICATION_SERVICE_URL=https://your-modification-service.example

# Monitoring toggles are safe defaults. Leave false until packages/secrets are configured.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_LOGROCKET=false

# Optional monitoring configuration
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_LOGROCKET_APP_ID=
