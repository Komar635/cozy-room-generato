# PostgreSQL
DATABASE_URL=postgresql://app_user:your_secure_password@host:5432/reality_digitizer_3d

# Yandex Object Storage
YC_STORAGE_REGION=ru-central1
YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_BUCKET=reality-digitizer-3d
YC_STORAGE_ACCESS_KEY=your-yandex-storage-access-key
YC_STORAGE_SECRET_KEY=your-yandex-storage-secret-key
YC_STORAGE_PUBLIC_URL=https://reality-digitizer-3d.storage.yandexcloud.net

# Service Configuration
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0

# Real photogrammetry pipeline
# Install COLMAP and set this to the executable path if it is not on PATH.
COLMAP_BIN=colmap
# exhaustive works for unordered object photo sets; sequential is faster for ordered capture paths.
PHOTOGRAMMETRY_MATCHER=exhaustive
PHOTOGRAMMETRY_TIMEOUT_SECONDS=1800
PHOTOGRAMMETRY_MAX_IMAGE_SIZE=2000
PHOTOGRAMMETRY_KEEP_TEMP_FILES=false
